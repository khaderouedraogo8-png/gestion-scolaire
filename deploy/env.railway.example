# Variables d'environnement — déploiement Railway
# À saisir dans l'onglet Variables du service web (ne pas committer de secrets)

FLASK_ENV=production

# Référence vers le plugin PostgreSQL Railway :
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# Secrets (python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=
REFRESH_SECRET_KEY=
ENCRYPTION_KEY=
QR_HMAC_SECRET=

# URL publique générée par Railway (Settings → Networking → Generate Domain)
CORS_ORIGINS=https://votre-service.up.railway.app

# Seed au premier démarrage uniquement
RUN_SEED=true

GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
UPLOAD_FOLDER=/app/uploads

# Optionnel — plugin Redis Railway :
# REDIS_URL=${{Redis.REDIS_URL}}
# RATELIMIT_STORAGE_URI=${{Redis.REDIS_URL}}

# SMTP (notifications email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@votre-domaine.fr
