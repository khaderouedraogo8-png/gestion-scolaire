# Copier vers deploy/.env.prod et renseigner les secrets (ne pas committer)
# cp deploy/env.prod.example deploy/.env.prod

# --- Base de données ---
POSTGRES_USER=gestion
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=gestion_scolaire

# --- Backend ---
FLASK_ENV=production
DATABASE_URL=postgresql+psycopg2://gestion:CHANGE_ME_STRONG_PASSWORD@postgres:5432/gestion_scolaire

# Secrets (générer : python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=CHANGE_ME_32_CHARS_MINIMUM________
REFRESH_SECRET_KEY=CHANGE_ME_REFRESH________________
ENCRYPTION_KEY=CHANGE_ME_32_CHARS_ENCRYPTION_KEY!!
QR_HMAC_SECRET=CHANGE_ME_QR_HMAC___________________

# URL publique du site (CORS + cookies)
CORS_ORIGINS=https://votre-domaine.fr

# Seed au premier démarrage (false après init)
RUN_SEED=true

# Gunicorn
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120

# --- Nginx ---
HTTP_PORT=80

# TLS (scripts/setup-ssl.sh)
DOMAIN=votre-domaine.fr

# Rate limiting (Redis — service redis du compose prod)
RATELIMIT_STORAGE_URI=redis://redis:6379/0

# --- SMTP (notifications email) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@votre-domaine.fr

# --- SMS HTTP (optionnel) ---
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=ECOLE

# --- Sauvegardes (service backup) ---
BACKUP_RETENTION_DAYS=30
