# Production — copier vers .env sur le serveur (ne pas committer)

FLASK_ENV=production
DATABASE_URL=postgresql+psycopg2://gestion:CHANGE_ME@postgres:5432/gestion_scolaire
JWT_SECRET_KEY=CHANGE_ME_32_CHARS_MINIMUM________
REFRESH_SECRET_KEY=CHANGE_ME_REFRESH________________
ENCRYPTION_KEY=CHANGE_ME_32_CHARS_ENCRYPTION_KEY!!
CORS_ORIGINS=https://votre-domaine.fr

# SMTP (relances email)
SMTP_HOST=smtp.votre-fournisseur.fr
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@votre-domaine.fr

# SMS HTTP (optionnel — sinon stub log)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=ECOLE
