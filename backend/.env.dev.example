# Dev local sans Docker — copier vers backend/.env
FLASK_ENV=development
DATABASE_URL=postgresql+psycopg2://gestion:gestion_dev@localhost:5432/gestion_scolaire

JWT_SECRET_KEY=dev-jwt-secret-change-in-production
REFRESH_SECRET_KEY=dev-refresh-secret-change-in-production
ENCRYPTION_KEY=dev-encryption-key-32chars-min!!
QR_HMAC_SECRET=dev-qr-hmac-secret

CORS_ORIGINS=http://localhost:5173
RATELIMIT_STORAGE_URI=memory://

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@ecole.local

UPLOAD_FOLDER=uploads

# WeasyPrint (Windows) — MSYS2 Pango
WEASYPRINT_DLL_DIRECTORIES=C:\msys64\mingw64\bin
